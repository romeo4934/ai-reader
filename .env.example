# Copier vers /opt/ai-reader/.env (chmod 640, root:ai-reader). Ne jamais commiter.
AI_READER_ADDR=127.0.0.1:8091
AI_READER_DB=/opt/ai-reader/data/ai-reader.sqlite

# Traduction contextuelle — sans elle, /api/translate répond 503.
ANTHROPIC_API_KEY=

# Obligatoire : signe les cookies de session. openssl rand -hex 32
AI_READER_SECRET=

# Code à donner aux gens pour qu'ils créent un compte (/signup). Vide =
# inscriptions désactivées.
AI_READER_INVITE_CODE=

# Copie hors serveur des sauvegardes nocturnes (scripts/backup.sh). Vide =
# sauvegarde locale seulement dans /opt/ai-reader/backups.
B2_ACCOUNT_ID=
B2_APP_KEY=
B2_BUCKET=
